{
	"name": "obsidian-open-to-side",
	"version": "1.1.2",
	"description": "Cmd+Alt+click (or a modifier of your choice) opens links in the existing tab group to the right instead of always creating a new split.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src package.json",
		"install-local": "node scripts/install-local.mjs"
	},
	"keywords": [],
	"author": "Josh Sterckx",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.66.0"
	},
	"dependencies": {
		"monkey-around": "^2.3.0"
	}
}
